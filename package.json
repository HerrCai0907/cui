{
  "name": "cui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w @cui/web\" \"npm run dev -w @cui/api\"",
    "start": "node scripts/start.mjs",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "npm run openapi:generate -w @cui/api && npm run api-types:generate -w @cui/web",
    "prepare": "husky",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
